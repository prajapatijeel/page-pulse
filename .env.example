# ==========================================
# Page Pulse Backend — Environment Variables Template
# ==========================================

# Application Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Sequelize)
# Prefer DATABASE_URL for a managed database. It takes precedence over the
# individual DATABASE_* values below. Do not commit real credentials.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=page_pulse_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis Cache & Store
# Prefer REDIS_URL for a managed Redis instance. It takes precedence over
# REDIS_HOST and REDIS_PORT below. Do not commit real credentials.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=60

# HTTP Client (Axios)
REQUEST_TIMEOUT=5000
MAX_CONCURRENT_REQUESTS=100

# Rate Limiting (Throttler)
RATE_LIMIT_LIMIT=100
RATE_LIMIT_TTL=60

# Logging (Pino)
LOG_LEVEL=info
